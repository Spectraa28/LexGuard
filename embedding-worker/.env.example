# Database
DATABASE_URL=postgresql+psycopg2://admin:password@localhost:5435/lexguard

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_QUEUE=lexguard.document.parsing.queue

# Supervisor
SWEEP_INTERVAL_SECONDS=60
STUCK_TIMEOUT_SECONDS=300

# RabbitMQ Management (for /health endpoint)
RABBITMQ_MANAGEMENT_PORT=15672


# S3 keys or R2 keys 
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
